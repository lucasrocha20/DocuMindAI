PORT=3000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://documind:documind@localhost:5432/documind
REDIS_URL=redis://localhost:6379

UPLOAD_DIR=uploads

OPENAI_API_KEY=your-openai-api-key

# Rate limiting, per client IP: general limit and the tighter upload limit (each upload
# triggers a paid LLM call), both within THROTTLE_TTL_MS.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=300
# UPLOAD_RATE_LIMIT=10

# Production (NODE_ENV=production): the app refuses to start with a placeholder API key,
# a default database password, or no CORS_ORIGIN. Swagger (/docs) is then off unless
# ENABLE_SWAGGER=true. Set TRUST_PROXY to the number of reverse proxies in front of the app.
# NODE_ENV=production
# ENABLE_SWAGGER=false
# TRUST_PROXY=1
